# Neon pooled connection string (used by the app at runtime)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Neon direct (unpooled) connection string (used by drizzle-kit migrations)
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Hugging Face token (read access, "Make calls to Inference Providers") for live AI
# processing; seeded data works without it
HF_TOKEN=
# Optional: models to try in order (first available wins)
HF_MODELS=Qwen/Qwen2.5-72B-Instruct,Qwen/Qwen2.5-7B-Instruct,meta-llama/Llama-3.1-8B-Instruct
# Deepgram key (free tier) for live mic transcription. The browser gets a 60s token
# from /api/deepgram/token; the key needs Member scope to grant tokens. Without it the
# mic room falls back to typed lines.
DEEPGRAM_API_KEY=
# Required to store tenant secrets (BYOK keys, iCal feed addresses): 32+ random chars.
# Generate: openssl rand -base64 32. Rotating it makes stored secrets unreadable.
PARLEY_SECRET_KEY=
